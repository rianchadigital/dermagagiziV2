<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Pastikan server web mengutamakan index.php
  DirectoryIndex index.php index.html

  # 2. Jika request ke aset statis (/assets/...) dan filenya ada, sajikan langsung
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3. Request ke /assets/... jika belum ada di root diarahkan ke dist/assets/...
  RewriteCond %{REQUEST_URI} ^/assets/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/dist/assets/%1 -f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 4. Arahkan homepage dan index.html ke index.php dispatcher
  RewriteRule ^$ index.php [L]
  RewriteRule ^index\.html$ index.php [L]

  # 5. Routing Single Page Application (SPA): semua request halaman dialihkan ke index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "index\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
